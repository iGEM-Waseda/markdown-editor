{
  "name": "igem-wiki-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "npm run build:vendor",
    "build:vendor": "babel ./vendor/zenn-markdown-html/src --config-file ./vendor/zenn-markdown-html/.babelrc.json --extensions '.ts,.tsx' --ignore '**/*.d.ts' --out-dir ./vendor/zenn-markdown-html/lib && (tsc --project ./vendor/zenn-markdown-html/tsconfig.build.json --noEmitOnError false || true)",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "easymde": "^2.18.0",
    "next": "14.2.3",
    "react": "^18",
    "react-dom": "^18",
    "react-simplemde-editor": "^5.2.0",
    "zenn-content-css": "^0.1.154",
    "zenn-embed-elements": "^0.1.155",
    "zenn-markdown-html": "file:./vendor/zenn-markdown-html"
  },
  "devDependencies": {
    "@babel/cli": "^7.20.7",
    "@babel/core": "^7.20.12",
    "@babel/preset-env": "^7.20.2",
    "@babel/preset-typescript": "^7.18.6",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "babel-plugin-prismjs": "^2.1.0",
    "eslint": "^8",
    "eslint-config-next": "14.2.3",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
