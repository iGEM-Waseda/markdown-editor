# middlewareでのBasic認証に使うパスワード。
# ローカル開発時は .env.local にコピーして値を設定してください(.env.local はgit管理対象外)。
# 本番(Vercel)ではダッシュボードのEnvironment Variablesに同じキーで登録してください。
SITE_PASSWORD=

# GitHubへ原稿をpush & Issue作成するためのfine-grained personal access token。
# 対象リポジトリに対して Contents: Read and write, Issues: Read and write の権限が必要です。
GITHUB_TOKEN=

# push先リポジトリの設定。未設定の場合は下記の値がデフォルトで使われます。
WIKI_REPO_OWNER=iGEM-Waseda
WIKI_REPO_NAME=wiki_2026_manuscript
WIKI_REPO_BRANCH=main
